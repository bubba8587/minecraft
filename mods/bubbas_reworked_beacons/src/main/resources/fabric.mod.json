{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "Bubba's Reworked Beacons",
	"description": "Beacons take one item instead of powers and payment, reach every living thing, and can pair underground.",
	"authors": [
		"bubba8587"
	],
	"license": "MIT",
	"contact": {
		"homepage": "https://github.com/bubba8587/minecraft",
		"sources": "https://github.com/bubba8587/minecraft",
		"issues": "https://github.com/bubba8587/minecraft/issues"
	},
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.bubba8587.bubbas_reworked_beacons.BubbasReworkedBeacons"
		],
		"client": [
			"io.github.bubba8587.bubbas_reworked_beacons.client.BubbasReworkedBeaconsClient"
		],
		"bubbas_reworked_beacons:payload": [
			"io.github.bubba8587.bubbas_reworked_beacons.beacon.StandalonePayload"
		]
	},
	"mixins": [
		"bubbas_reworked_beacons.mixins.json",
		{
			"config": "bubbas_reworked_beacons.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	},
	"custom": {
		"modmenu": {
			"parent": {
				"id": "bubbas_mods",
				"name": "Bubba's Mods",
				"description": "Mods by bubba8587: reworked mobs, beacons and mining, totems and artifacts, infused gems and more."
			}
		}
	}
}
