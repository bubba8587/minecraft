{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "Bubba's Reworked Mining",
	"description": "Mining gets a real progression curve: early tools are slow, deepslate is tough, and Efficiency and Unbreaking matter much more.",
	"authors": [
		"bubba8587"
	],
	"license": "MIT",
	"contact": {
		"homepage": "https://github.com/bubba8587/minecraft",
		"sources": "https://github.com/bubba8587/minecraft",
		"issues": "https://github.com/bubba8587/minecraft/issues"
	},
	"icon": "assets/bubbas_reworked_mining/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.bubba8587.bubbas_reworked_mining.BubbasReworkedMining"
		],
		"client": [
			"io.github.bubba8587.bubbas_reworked_mining.client.BubbasReworkedMiningClient"
		]
	},
	"mixins": [
		"bubbas_reworked_mining.mixins.json",
		{
			"config": "bubbas_reworked_mining.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_dependency}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	},
	"custom": {
		"modmenu": {
			"parent": {
				"id": "bubbas_mods",
				"name": "Bubba's Mods",
				"description": "Mods by bubba8587: reworked mobs, beacons and mining, totems and artifacts, infused gems and more."
			}
		}
	}
}
