{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "Bubba's Reworked Mobs",
	"description": "Reworks Minecraft's mobs: dormant undead, giant spiders and nests, watcher creepers, cairn endermen, grabbing drowned, monster camps and more.",
	"authors": [
		"bubba8587"
	],
	"license": "MIT",
	"contact": {
		"homepage": "https://github.com/bubba8587/minecraft",
		"sources": "https://github.com/bubba8587/minecraft",
		"issues": "https://github.com/bubba8587/minecraft/issues"
	},
	"icon": "assets/bubbas_reworked_mobs/icon.png",
	"environment": "*",
	"entrypoints": {
		"bubbas_reworked_beacons:payload": [
			"io.github.bubba8587.bubbas_reworked_mobs.compat.FabricatorBeaconPayload"
		],
		"main": [
			"io.github.bubba8587.bubbas_reworked_mobs.BubbasReworkedMobs"
		],
		"client": [
			"io.github.bubba8587.bubbas_reworked_mobs.client.BubbasReworkedMobsClient"
		],
		"fabric-datagen": [
			"io.github.bubba8587.bubbas_reworked_mobs.client.datagen.ModDataGenerator"
		]
	},
	"mixins": [
		"bubbas_reworked_mobs.mixins.json",
		"bubbas_reworked_mobs.compat.mixins.json",
		{
			"config": "bubbas_reworked_mobs.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_dependency}",
		"java": ">=${java_version}",
		"fabric-api": "*",
		"stormiespiders": ">=3.3.1"
	},
	"suggests": {
		"bubbas_totems_artifacts": "*",
		"bubbas_reworked_beacons": "*"
	},
	"custom": {
		"modmenu": {
			"parent": {
				"id": "bubbas_mods",
				"name": "Bubba's Mods",
				"description": "Mods by bubba8587: reworked mobs, beacons and mining, totems and artifacts, infused gems and more."
			}
		}
	}
}
