{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "Bubba's Infused Gems",
	"description": "Brew potions into gems, enchant them, and socket them into armor and weapons for permanent, partial potion effects.",
	"authors": [
		"bubba8587"
	],
	"license": "MIT",
	"contact": {
		"homepage": "https://github.com/bubba8587/minecraft",
		"sources": "https://github.com/bubba8587/minecraft",
		"issues": "https://github.com/bubba8587/minecraft/issues"
	},
	"icon": "assets/bubbas_infused_gems/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.bubba8587.bubbas_infused_gems.BubbasInfusedGems"
		],
		"client": [
			"io.github.bubba8587.bubbas_infused_gems.client.BubbasInfusedGemsClient"
		],
		"bubbas_reworked_beacons:payload": [
			"io.github.bubba8587.bubbas_infused_gems.compat.GemBeaconPayload"
		]
	},
	"mixins": [
		"bubbas_infused_gems.mixins.json",
		{
			"config": "bubbas_infused_gems.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_dependency}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	},
	"suggests": {
		"bubbas_reworked_beacons": "*"
	},
	"custom": {
		"modmenu": {
			"parent": {
				"id": "bubbas_mods",
				"name": "Bubba's Mods",
				"description": "Mods by bubba8587: reworked mobs, beacons and mining, totems and artifacts, infused gems and more."
			}
		}
	}
}
