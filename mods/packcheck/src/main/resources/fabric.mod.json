{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "Pack Check",
	"description": "Internal test harness: runs game tests against the datapacks in datapacks/.",
	"authors": [
		"bubba8587"
	],
	"license": "MIT",
	"icon": "assets/packcheck/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.bubba8587.packcheck.Packcheck"
		],
		"client": [
			"io.github.bubba8587.packcheck.client.PackcheckClient"
		]
	},
	"mixins": [
		"packcheck.mixins.json",
		{
			"config": "packcheck.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
