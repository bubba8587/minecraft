{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "Bubba's Crafting Tweaks",
	"description": "Companion mod for the Bubba's Crafting Tweaks datapack: the Glider and Synthetic Diamond Ore.",
	"authors": [
		"bubba8587"
	],
	"license": "MIT",
	"icon": "assets/bubbas_crafting_tweaks/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.bubba8587.bubbas_crafting_tweaks.BubbasCraftingTweaks"
		],
		"client": [
			"io.github.bubba8587.bubbas_crafting_tweaks.client.BubbasCraftingTweaksClient"
		]
	},
	"mixins": [
		"bubbas_crafting_tweaks.mixins.json",
		{
			"config": "bubbas_crafting_tweaks.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
