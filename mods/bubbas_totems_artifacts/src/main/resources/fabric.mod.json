{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "Bubba's Totems & Artifacts",
	"description": "Found artifacts that do what potions and enchantments don't: the Grave Talisman and the Totems of Warding, Keeping, Gathering, Fortification, Growth, Seeking, the Beginning, the End and the North Wind.",
	"authors": [
		"bubba8587"
	],
	"license": "MIT",
	"contact": {
		"homepage": "https://github.com/bubba8587/minecraft",
		"sources": "https://github.com/bubba8587/minecraft",
		"issues": "https://github.com/bubba8587/minecraft/issues"
	},
	"icon": "assets/bubbas_totems_artifacts/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.bubba8587.bubbas_totems_artifacts.BubbasTotemsArtifacts"
		],
		"client": [
			"io.github.bubba8587.bubbas_totems_artifacts.client.BubbasTotemsArtifactsClient"
		],
		"bubbas_reworked_beacons:payload": [
			"io.github.bubba8587.bubbas_totems_artifacts.compat.WardingBeaconPayload",
			"io.github.bubba8587.bubbas_totems_artifacts.compat.GatheringBeaconPayload",
			"io.github.bubba8587.bubbas_totems_artifacts.compat.FortificationBeaconPayload",
			"io.github.bubba8587.bubbas_totems_artifacts.compat.GrowthBeaconPayload",
			"io.github.bubba8587.bubbas_totems_artifacts.compat.SeekingBeaconPayload",
			"io.github.bubba8587.bubbas_totems_artifacts.compat.BeginningBeaconPayload",
			"io.github.bubba8587.bubbas_totems_artifacts.compat.HerdingBeaconPayload",
			"io.github.bubba8587.bubbas_totems_artifacts.compat.ClearSkiesBeaconPayload",
			"io.github.bubba8587.bubbas_totems_artifacts.compat.NorthWindBeaconPayload"
		]
	},
	"mixins": [
		"bubbas_totems_artifacts.mixins.json",
		{
			"config": "bubbas_totems_artifacts.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_dependency}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	},
	"suggests": {
		"bubbas_reworked_mobs": "*",
		"bubbas_reworked_beacons": "*"
	},
	"custom": {
		"modmenu": {
			"parent": {
				"id": "bubbas_mods",
				"name": "Bubba's Mods",
				"description": "Mods by bubba8587: reworked mobs, beacons and mining, totems and artifacts, infused gems and more."
			}
		}
	}
}
