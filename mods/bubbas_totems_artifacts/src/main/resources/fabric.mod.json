{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "Bubba's Totems & Artifacts",
	"description": "Found artifacts that do what potions and enchantments don't: the Grave Talisman and the Totems of Warding, Keeping, Gathering, Fortification, Growth, Seeking, the Beginning and the End.",
	"authors": [
		"bubba8587"
	],
	"license": "MIT",
	"icon": "assets/bubbas_totems_artifacts/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.bubba8587.bubbas_totems_artifacts.BubbasTotemsArtifacts"
		],
		"client": [
			"io.github.bubba8587.bubbas_totems_artifacts.client.BubbasTotemsArtifactsClient"
		],
		"bubbas_reworked_beacons:payload": [
			"io.github.bubba8587.bubbas_totems_artifacts.compat.WardingBeaconPayload",
			"io.github.bubba8587.bubbas_totems_artifacts.compat.GatheringBeaconPayload",
			"io.github.bubba8587.bubbas_totems_artifacts.compat.FortificationBeaconPayload",
			"io.github.bubba8587.bubbas_totems_artifacts.compat.GrowthBeaconPayload",
			"io.github.bubba8587.bubbas_totems_artifacts.compat.SeekingBeaconPayload",
			"io.github.bubba8587.bubbas_totems_artifacts.compat.BeginningBeaconPayload"
		]
	},
	"mixins": [
		"bubbas_totems_artifacts.mixins.json",
		{
			"config": "bubbas_totems_artifacts.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	},
	"suggests": {
		"bubbas_reworked_mobs": "*",
		"bubbas_reworked_beacons": "*"
	}
}
