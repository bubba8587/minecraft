{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "Bubba's Extra Recipes",
	"description": "Companion mod for the Bubba's Extra Recipes datapack: the Glider and Synthetic Diamond Ore.",
	"authors": [
		"bubba8587"
	],
	"license": "MIT",
	"contact": {
		"homepage": "https://github.com/bubba8587/minecraft",
		"sources": "https://github.com/bubba8587/minecraft",
		"issues": "https://github.com/bubba8587/minecraft/issues"
	},
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.bubba8587.bubbas_extra_recipes.BubbasExtraRecipes"
		],
		"client": [
			"io.github.bubba8587.bubbas_extra_recipes.client.BubbasExtraRecipesClient"
		]
	},
	"mixins": [
		"bubbas_extra_recipes.mixins.json"
