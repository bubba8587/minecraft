+	/** Large camps built at every offset to the chunk grid, away from the field: fences joined across chunk edges, no lone rail. */
+	@GameTest(structure = FIELD, maxTicks = 20)
+	public void campFencesJoinAcrossChunkEdges(GameTestHelper helper) {
+		ServerLevel level = helper.getLevel();
+		List<String> faults = new ArrayList<>();
+		for (int off = 0; off < 16; off++) {
+			for (CampKind kind : CampKind.values()) {
+				BlockPos at = helper.absolutePos(new BlockPos(16, 8, 24)).offset(4000 + off * 37 + kind.ordinal() * 300, 0, 4000 + off * 23);
+				CampPiece piece = CampCommand.build(level, at, kind, CampTuning.Size.LARGE, 3L + off);
+				List<String> f = fenceFaults(level, piece.getBoundingBox());
+				if (!f.isEmpty()) {
+					faults.add(kind + " at " + at.toShortString() + ": " + f.subList(0, Math.min(4, f.size())));
+				}
+			}
+		}
+		helper.assertTrue(faults.isEmpty(), faults.size() + " camps with fence faults, e.g. " + faults.subList(0, Math.min(4, faults.size())));
+		helper.succeed();
+	}
 }
